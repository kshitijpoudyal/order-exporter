{
  "manifest_version": 3,
  "name": "Order History Exporter",
  "short_name": "Order Exporter",
  "version": "1.1.0",
  "description": "Export your own order history from Amazon, Walmart, Costco and Sam's Club to Excel or CSV. Data stays in your browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.samsclub.com/*",
    "https://www.walmart.com/*",
    "https://www.costco.com/*",
    "https://www.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Export order history",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.samsclub.com/*",
        "https://www.walmart.com/*",
        "https://www.costco.com/*",
        "https://www.amazon.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.samsclub.com/*",
        "https://www.walmart.com/*",
        "https://www.costco.com/*",
        "https://www.amazon.com/*"
      ],
      "js": [
        "src/retailers.js",
        "src/lib/normalize.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "pages/retailers.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "src/background.js"
  }
}
